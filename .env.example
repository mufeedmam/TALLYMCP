# ─── Supabase Postgres connection ────────────────────────────────────────────
# From Supabase → Project Settings → Database → Connection string (Session pooler).
PGHOST=aws-0-xx-xxxx-x.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.xxxxxxxxxxxx
PGPASSWORD=your-db-password
PGSSLMODE=require

# Full connection string — the ONLY variable the web app needs at runtime.
# Also copy this into web/.env.local for local dev. Never expose it via NEXT_PUBLIC_*.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ─── Reference Tally Database Loader (data pipeline only) ─────────────────────
# Path (relative to loader/sync.mjs) to the reused loader with dist/ + tally-export-config.yaml.
LOADER_DIR=../../tally-database-loader-utility-1.0.43
LOAD_METHOD=insert

# ─── Tally (data pipeline only; needs LAN access to Tally on port 9000) ───────
TALLY_SERVER=localhost
TALLY_PORT=9000
# Exact Tally company name (blank = whichever company is currently open in Tally).
TALLY_COMPANY=""
TALLY_FROMDATE=2020-04-01
TALLY_TODATE=2027-03-31
